{
  "name": "proofpay",
  "version": "0.1.0",
  "private": true,
  "description": "ProofPay - payment released only when the work is proven (PayPal + AI)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx scripts/doctor.ts",
    "smoke": "tsx scripts/live-smoke.ts",
    "live-ai": "tsx scripts/live-ai.ts",
    "e2e:live": "tsx scripts/live-e2e.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "demo": "npm run build && npm start",
    "e2e": "playwright test",
    "live-vision": "tsx scripts/live-vision.ts",
    "secrets": "tsx scripts/check-secrets.ts",
    "check:live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vansh-shriv/ProofPay.git"
  },
  "homepage": "https://proofpay-kjpo.onrender.com",
  "bugs": {
    "url": "https://github.com/vansh-shriv/ProofPay/issues"
  },
  "keywords": [
    "paypal",
    "ai-agents",
    "agentic-commerce",
    "escrow",
    "payments",
    "hackathon"
  ]
}
