# Copy to .env and fill in. NEVER commit .env.
# With the defaults below the whole app runs offline with no keys (demo mode).

# --- Payments ---
# mock   = offline PayPal simulator, no keys needed (default, great for a first run)
# paypal = real PayPal SANDBOX calls (fill the three PAYPAL_* values first)
PAYMENTS_MODE=mock
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox PERSONAL account email that receives worker payouts in the demo
PAYPAL_WORKER_EMAIL=
PAYPAL_WORKER_EMAIL_PASSWORD=

PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_EMAIL_PASSWORD=


# --- AI ---
# mock   = offline deterministic AI (no key)
# gemini = Google Gemini free tier (key from aistudio.google.com)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# --- App ---
PORT=3000
APP_BASE_URL=http://localhost:3000
DB_PATH=./data/proofpay.db
